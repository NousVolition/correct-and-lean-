import HeatAccounting
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace RecordedHeat

def decimalScale : Nat := 10000000000000000000000000000000000
def globalTolerance : Nat := 10000000000000000000000
def tagTolerance : Nat := 100000000000000000000

structure Row where
  step : Nat
  phase : Nat
  thermal : Int
  initial : Int
  viscous : Int
  released : Int
  w0 : Int
  w1 : Int
  w2 : Int
  integratedViscous : Int
  integratedRelease : Int
  continuousLedger : Int
  writeLedger : Int
  deriving DecidableEq, Repr

def expectedWrite (r : Row) (birth : Nat) (amount : Int) : Int :=
  if birth < r.step ∨ (birth = r.step ∧ r.phase = 2) then amount else 0

def Good (initial h0 h1 h2 : Int) (f0 f1 f2 : Nat) (r : Row) : Prop :=
  (r.thermal-(r.initial+r.viscous+r.released+r.w0+r.w1+r.w2)).natAbs ≤ globalTolerance ∧
  (r.thermal-(initial+r.continuousLedger+r.writeLedger)).natAbs ≤ globalTolerance ∧
  (r.initial-initial).natAbs ≤ tagTolerance ∧
  (r.viscous-r.integratedViscous).natAbs ≤ tagTolerance ∧
  (r.released-r.integratedRelease).natAbs ≤ tagTolerance ∧
  (r.continuousLedger-r.integratedViscous-r.integratedRelease).natAbs ≤ tagTolerance ∧
  (r.w0-expectedWrite r f0 h0).natAbs ≤ tagTolerance ∧
  (r.w1-expectedWrite r f1 h1).natAbs ≤ tagTolerance ∧
  (r.w2-expectedWrite r f2 h2).natAbs ≤ tagTolerance ∧
  (r.writeLedger-expectedWrite r f0 h0-expectedWrite r f1 h1-expectedWrite r f2 h2).natAbs ≤ tagTolerance

instance (initial h0 h1 h2 : Int) (f0 f1 f2 : Nat) (r : Row) : Decidable (Good initial h0 h1 h2 f0 f1 f2 r) := by unfold Good; infer_instance

