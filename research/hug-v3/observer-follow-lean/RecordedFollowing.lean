def decimalScale : Nat := 100000000000000000000000000000000
def tolerance : Nat := 100000000000000000000

structure Point where
  step : Nat
  only540 : Int
  only872 : Int
  shared : Int
  neither : Int
  added : Int
  current : Int
  theta : Int
  deriving DecidableEq, Repr

def PointGood (p : Point) : Prop := (p.current-p.only540-p.only872-p.shared-p.neither-p.added).natAbs ≤ tolerance ∧ p.only540 ≥ -(Int.ofNat tolerance) ∧ p.only872 ≥ -(Int.ofNat tolerance) ∧ p.shared ≥ -(Int.ofNat tolerance) ∧ p.neither ≥ -(Int.ofNat tolerance) ∧ p.added ≥ -(Int.ofNat tolerance)
instance (p : Point) : Decidable (PointGood p) := by unfold PointGood; infer_instance

def WindowGood (a : Account) : Prop := Within a tolerance ∧ a.oldInside ≥ -(Int.ofNat tolerance) ∧ a.oldOutside ≥ -(Int.ofNat tolerance) ∧ a.incoming ≥ -(Int.ofNat tolerance) ∧ a.added ≥ -(Int.ofNat tolerance)
instance (a : Account) : Decidable (WindowGood a) := by unfold WindowGood; infer_instance

structure FieldChange where
  id : Nat
  deformation : Int
  materialField : Int
  minimumStep : Int
  deriving DecidableEq, Repr

structure Crossing where
  id : Nat
  stepBefore : Nat
  stepAfter : Nat
  timeBefore : Int
  timeAfter : Int
  distanceBefore : Int
  distanceAfter : Int
  cBefore : Int
  cAfter : Int
  thetaBefore : Int
  thetaAfter : Int
  deriving DecidableEq, Repr

structure PairOrigin where
  original : Int
  other : Int
  added : Int
  current : Int
  deriving DecidableEq, Repr

