import OriginTracking
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace RecordedOrigins
open OriginTracking

def decimalScale : Nat := 100000000000000000000000000000000
def tolerance : Nat := 100000000000000000000

structure PointAccount where
  original : Int
  incoming : Int
  added : Int
  current : Int
  deriving DecidableEq, Repr

def PointGood (a : PointAccount) : Prop :=
  (a.current-a.original-a.incoming-a.added).natAbs ≤ tolerance ∧
  a.original ≥ -(Int.ofNat tolerance) ∧ a.incoming ≥ -(Int.ofNat tolerance) ∧ a.added ≥ -(Int.ofNat tolerance)
instance (a : PointAccount) : Decidable (PointGood a) := by unfold PointGood; infer_instance

def WindowGood (a : Account) : Prop := Within a tolerance ∧
  a.oldInside ≥ -(Int.ofNat tolerance) ∧ a.oldOutside ≥ -(Int.ofNat tolerance) ∧
  a.incoming ≥ -(Int.ofNat tolerance) ∧ a.added ≥ -(Int.ofNat tolerance)
instance (a : Account) : Decidable (WindowGood a) := by unfold WindowGood; infer_instance

