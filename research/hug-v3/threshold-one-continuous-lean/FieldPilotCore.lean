def fieldModel : FrozenComplexModel.Model := treeModel D hD degree A powers tree
theorem field_sound : FrozenIntModel.Models D fieldModel.re
    (fun x => FrozenField.value (flatten tree) archiveDenominator (q x)) := by
  exact tree_models hD degree (by decide) archiveDenominator_positive (by decide) powers_sound tree

def proposedPolynomial : Poly := [-363840675115850725009330058751158644776805760592686966810,
7701492842550498433343362545472017632323069170847034094,
61668542640984108817461880484502180232299857617110718,
-355200806592963216837464539510679035200714886653722,
-358664686654460893220712778375084400641714202165,
-1576898776053418391835943448592676920714169203,
-65647086800692393666721429464501665879739557,
210793779727686734987938036664671190852649,
12866241187722579909981051332084209394,
-34748897719816474796334156125213408039,
440672134924034700059959744323171737,
655318991560477725434888400165965,
-22965672896513657890642391763131]
def proposedError : ℤ := 4911761590083677511043984710842114398871
theorem checked_field : fieldModel.re.polynomial = proposedPolynomial ∧
    fieldModel.re.error = proposedError := by decide +kernel
theorem checked_error : proposedError * 10^18 ≤ D := by decide
theorem continuous_field_enclosure (x : ℝ) (hx : |x| ≤ 1) :
    |FrozenField.value (flatten tree) archiveDenominator (q x) -
      eval proposedPolynomial x / D| ≤ (1 / 10^18 : ℝ) := by
  have h := field_sound x hx
  rw [checked_field.1, checked_field.2] at h
  apply le_trans h
  have hd : (0 : ℝ) < D := by exact_mod_cast hD
  apply (div_le_div_iff₀ hd (by positivity : (0 : ℝ) < 10^18)).mpr
  have he : (proposedError : ℝ) * 10^18 ≤ (D : ℝ) := by exact_mod_cast checked_error
  simpa only [one_mul] using he
#print axioms checked_field
#print axioms continuous_field_enclosure
end FieldPilotCore
