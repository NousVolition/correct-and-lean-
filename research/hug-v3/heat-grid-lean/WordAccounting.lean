namespace WordAccounting

structure Stats where
  changedBytes : Nat
  changedWords : Nat
  changedBits : Nat
  leftOnes : Nat
  rightOnes : Nat
  deriving DecidableEq, Repr

def bitCount16 (n : Nat) : Nat := ((List.range 16).filter (fun k => n.testBit k)).length

def bitDistance16 (a b : Nat) : Nat :=
  ((List.range 16).filter (fun k => a.testBit k != b.testBit k)).length

def statistics (words : List (Nat × Nat)) : Stats := words.foldl (fun s p =>
  { changedBytes := s.changedBytes + (if p.1 % 256 = p.2 % 256 then 0 else 1) +
      (if p.1 / 256 = p.2 / 256 then 0 else 1)
    changedWords := s.changedWords + (if p.1 = p.2 then 0 else 1)
    changedBits := s.changedBits + bitDistance16 p.1 p.2
    leftOnes := s.leftOnes + bitCount16 p.1
    rightOnes := s.rightOnes + bitCount16 p.2 }) ⟨0,0,0,0,0⟩

theorem fixed_reference_cost_partition (left right fixed : ℚ) :
    right - left = (right - fixed) + (fixed - left) := by ring

end WordAccounting
