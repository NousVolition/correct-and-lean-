+/-- The full push repeats because its spatial pattern is fixed. -/
+theorem push_repeats {S X : Type} (pattern : X → ℝ) (peak period t : ℝ)
+    (state : S) (nonzero : period ≠ 0) :
+    push pattern peak period (t + period) state = push pattern peak period t state := by
+  funext x
+  simp only [push, amplitude_repeats peak period t nonzero]
+
+/-- The push bound retains the size of the spatial pattern. -/
+theorem push_bounded_by_pattern {S X : Type} (pattern : X → ℝ) (peak period t : ℝ)
+    (state : S) (x : X) :
+    |push pattern peak period t state x| ≤ |peak| * |pattern x| := by
+  unfold push
+  rw [abs_mul]
+  exact mul_le_mul_of_nonneg_right (amplitude_bounded peak period t) (abs_nonneg _)
+
+/-- A peak-only bound for the push requires a unit bound on the pattern. -/
+theorem push_bounded_for_unit_pattern {S X : Type} (pattern : X → ℝ)
+    (peak period t : ℝ) (state : S) (x : X) (unit : |pattern x| ≤ 1) :
+    |push pattern peak period t state x| ≤ |peak| := by
+  calc
+    |push pattern peak period t state x| ≤ |peak| * |pattern x| :=
+      push_bounded_by_pattern pattern peak period t state x
+    _ ≤ |peak| * 1 := mul_le_mul_of_nonneg_left unit (abs_nonneg _)
+    _ = |peak| := mul_one _
+
