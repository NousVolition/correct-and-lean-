def groups : List Group := fourKPa :: otherGroups

abbrev Measured := {g : Group // g ∈ groups}

/-- A state is one of the two rows of a listed group. -/
def presentStress (s : Measured × Bool) : Nat := s.1.1.present

def pastStress (s : Measured × Bool) : Nat := cond s.2 s.1.1.pastHigh s.1.1.pastLow

theorem group_count : groups.length = 252 := by decide +kernel

theorem every_group_has_two_histories :
    groups.all (fun g => decide (g.pastLow < g.pastHigh)) = true := by
  decide +kernel

theorem same_present_stress (g : Measured) :
    presentStress (g, false) = presentStress (g, true) := rfl

theorem different_past_stress (g : Measured) :
    pastStress (g, false) ≠ pastStress (g, true) := by
  have listed := (List.all_eq_true.mp every_group_has_two_histories) g.1 g.2
  have smaller : g.1.pastLow < g.1.pastHigh := of_decide_eq_true listed
  show g.1.pastLow ≠ g.1.pastHigh
  exact Nat.ne_of_lt smaller

/-- The ambiguous-observation rule, for a property of any type. Same proof as
`SIMSLatentReadout.no_exact_reader_of_ambiguous_observation`. -/
theorem no_exact_reader_of_any_property {S O P : Type}
    (observe : S → O) (property : S → P) (a b : S)
    (same : observe a = observe b) (different : property a ≠ property b) :
    ¬ ∃ reader : O → P, ∀ s, reader (observe s) = property s :=
  fun ⟨reader, correct⟩ =>
    different ((correct a).symm.trans ((congrArg reader same).trans (correct b)))

def fourKPaMeasured : Measured := ⟨fourKPa, List.Mem.head _⟩

/-- The measured instance: no rule that reads only the stress a clay carries now can give,
for every listed row, the largest stress it has carried. -/
theorem present_stress_cannot_give_past_stress :
    ¬ ∃ reader : Nat → Nat, ∀ s : Measured × Bool, reader (presentStress s) = pastStress s :=
  no_exact_reader_of_any_property presentStress pastStress
    (fourKPaMeasured, false) (fourKPaMeasured, true)
    (same_present_stress fourKPaMeasured) (different_past_stress fourKPaMeasured)

/-- The 4 kPa pair in plain numbers: past stresses of 22 kPa and 165 kPa. -/
theorem four_kPa_pair :
    fourKPa.present = 4 * unitsPerKPa ∧ fourKPa.pastLow = 22 * unitsPerKPa ∧
      fourKPa.pastHigh = 165 * unitsPerKPa := by
  decide +kernel

end ClayMemoryInstance

