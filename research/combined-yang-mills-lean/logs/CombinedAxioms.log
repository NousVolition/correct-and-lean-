'YangMillsCombined.combined_observation_and_residual' depends on axioms: [propext, Classical.choice, Quot.sound]
YangMillsCombined.combined_observation_and_residual (p : TwoMemoryTransport.Point) (h : p 1 = 0) :
  (∀ (j : Fin 4), TwoMemoryTransport.potential j p = YangMillsCueTest.transversePotential j p) ∧
    (∀ (i j : Fin 4),
        TwoMemoryTransport.partialDerivative i (TwoMemoryTransport.potential j) p =
          TwoMemoryTransport.partialDerivative i (YangMillsCueTest.transversePotential j) p) ∧
      YangMillsCombined.transverseReading TwoMemoryTransport.potential p 0 =
          YangMillsCombined.transverseReading YangMillsCueTest.transversePotential p 0 ∧
        YangMillsCombined.transverseReading TwoMemoryTransport.potential p 1 =
            YangMillsCombined.transverseReading YangMillsCueTest.transversePotential p 1 ∧
          YangMillsCombined.transverseReading TwoMemoryTransport.potential p 2 =
              TwoMemoryTransport.partialDerivative 1
                (TwoMemoryTransport.partialDerivative 1 (TwoMemoryTransport.potential 2)) p ∧
            YangMillsCombined.transverseReading YangMillsCueTest.transversePotential p 2 =
                TwoMemoryTransport.partialDerivative 1
                  (TwoMemoryTransport.partialDerivative 1 (YangMillsCueTest.transversePotential 2)) p ∧
              YangMillsCombined.transverseReading TwoMemoryTransport.potential p 2 =
                  TwoMemoryTransport.yangMillsResidual TwoMemoryTransport.potential 2 p ∧
                YangMillsCombined.transverseReading YangMillsCueTest.transversePotential p 2 =
                    TwoMemoryTransport.yangMillsResidual YangMillsCueTest.transversePotential 2 p ∧
                  TwoMemoryTransport.yangMillsResidual TwoMemoryTransport.potential 2 p = 0 ∧
                    TwoMemoryTransport.yangMillsResidual YangMillsCueTest.transversePotential 2 p = 2 ∧
                      TwoMemoryTransport.yangMillsResidual TwoMemoryTransport.potential 2 p ≠
                        TwoMemoryTransport.yangMillsResidual YangMillsCueTest.transversePotential 2 p
